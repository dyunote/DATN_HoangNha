html=1;align=left;spacingLeft=10;fillColor=#F5F7FA;strokeColor=#C7D0DB;fontSize=11;fontColor=#0F2B46;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="700" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>