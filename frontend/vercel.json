{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://DOI-THANH-DOMAIN-BACKEND/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://DOI-THANH-DOMAIN-BACKEND/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
