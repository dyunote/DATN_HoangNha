# Copy file nay thanh .env roi sua cho may cua ban / cho hosting.
# Tren hosting (Render, Railway, cPanel...) nen khai bao thang o bang dieu khien
# thay vi upload file .env.

# ============ MOI TRUONG ============
# Dat "production" khi chay that: giau chi tiet loi, siet CORS, bat buoc JWT_SECRET.
NODE_ENV="development"
# Hosting thuong tu cap PORT — de trong thi mac dinh 4000.
PORT=4000

# ============ CSDL ============
# Local (XAMPP): root, khong mat khau, cong 3306
DATABASE_URL="mysql://root:@localhost:3306/hoangnha_fashion"
# Hosting: mysql://<user>:<pass>@<host>:3306/<db>  (them ?sslaccept=strict neu nha cung cap yeu cau SSL)

# ============ BAO MAT ============
# BAT BUOC khi NODE_ENV=production. Sinh chuoi ngau nhien:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai"

# Cac ten mien duoc phep goi API, cach nhau bang dau phay. KHONG co dau / o cuoi.
# De trong neu backend phuc vu luon frontend/dist (cung mot ten mien).
CORS_ORIGIN=""

# Thu muc chua ban build cua frontend. Mac dinh: ../frontend/dist
# Backend tu phuc vu giao dien + SPA fallback neu thu muc nay ton tai.
# CLIENT_DIR=""

# ============ SEPAY - Thanh toan chuyen khoan ngan hang ============
# 1. Dang ky mien phi tai https://my.sepay.vn va lien ket tai khoan ngan hang
# 2. Vao menu Webhooks -> Them webhook:
#    - URL: https://<ten-mien-cua-ban>/api/sepay/webhook
#    - Su kien: Co tien vao
#    - Bao mat: API Key -> dat chuoi ngau nhien, dan vao SEPAY_API_KEY duoi day
# 3. Khi dev tren may ca nhan: chay ngrok http 4000 va dung URL ngrok o buoc 2.

# So tai khoan nhan tien
SEPAY_ACCOUNT=""
# Ma ngan hang, danh sach: https://qr.sepay.vn/banks.json (vd: MBBank, Vietcombank, ACB)
SEPAY_BANK="MBBank"
# API Key trung voi cai da dat tren my.sepay.vn
SEPAY_API_KEY=""
# QR het han sau bao nhieu phut
SEPAY_EXPIRE_MINUTES=15

# ============ CHAT AI HO TRO KHACH HANG (Claude) ============
# Lay API key tai https://platform.claude.com/settings/keys
# De trong -> chat van hoat dong bang bot mien phi (rule-based, tra loi tu MySQL)
# Co key -> tu dong nang cap sang chat AI (Claude), khong can sua code
ANTHROPIC_API_KEY=""
